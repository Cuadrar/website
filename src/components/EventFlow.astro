<section class="flow-section" id="how-it-works">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">EVENT FLOW EXPLORER</span>
            <h2>From event to insight.</h2>
            <p>
                Follow an event through your services and identify where
                processing succeeds or fails.
            </p>
        </div>

        <div class="demo">
            <div class="demo-toolbar">
                <div class="demo-title">
                    <span class="live-dot"></span>
                    Live event simulation
                </div>

                <div class="scenario-switch">
                    <button
                            type="button"
                            class="scenario active"
                            data-scenario="healthy"
                            aria-pressed="true"
                    >
                        Healthy flow
                    </button>

                    <button
                            type="button"
                            class="scenario"
                            data-scenario="failed"
                            aria-pressed="false"
                    >
                        Failed flow
                    </button>
                </div>
            </div>

            <div class="graph-container">
                <svg
                        class="graph"
                        viewBox="0 0 800 390"
                        role="img"
                        aria-label="Event flow from Order Service through Kafka to Payment and Inventory services"
                >
                    <defs>
                        <linearGradient id="flow-gradient" x1="0" y1="0" x2="1" y2="0">
                            <stop offset="0%" stop-color="#2dd4bf" />
                            <stop offset="100%" stop-color="#5eead4" />
                        </linearGradient>
                    </defs>

                    <!-- Connections -->
                    <g class="connections">
                        <path id="path-order" d="M400 92 V150" />
                        <path id="path-payment" d="M400 220 V255 H220 V285" />
                        <path id="path-inventory" d="M400 220 V255 H580 V285" />
                    </g>

                    <!-- Animated event particles -->
                    <circle class="particle particle-order" r="5">
                        <animateMotion
                                dur="1.5s"
                                repeatCount="indefinite"
                                path="M400 92 V150"
                        />
                    </circle>

                    <circle class="particle particle-payment" r="5">
                        <animateMotion
                                dur="2s"
                                repeatCount="indefinite"
                                path="M400 220 V255 H220 V285"
                        />
                    </circle>

                    <circle class="particle particle-inventory" r="5">
                        <animateMotion
                                dur="2s"
                                repeatCount="indefinite"
                                path="M400 220 V255 H580 V285"
                        />
                    </circle>

                    <!-- Order Service -->
                    <g class="node">
                        <rect x="300" y="30" width="200" height="62" rx="10" />
                        <text x="400" y="56" class="node-title">Order Service</text>
                        <text x="400" y="75" class="node-subtitle">
                            OrderCreated
                        </text>
                    </g>

                    <!-- Kafka -->
                    <g class="node broker">
                        <rect x="300" y="150" width="200" height="70" rx="10" />
                        <text x="400" y="180" class="node-title">Kafka</text>
                        <text x="400" y="199" class="node-subtitle">
                            Event Broker
                        </text>
                    </g>

                    <!-- Payment Service -->
                    <g class="node success-node">
                        <rect x="120" y="285" width="200" height="70" rx="10" />
                        <text x="220" y="313" class="node-title">
                            Payment Service
                        </text>
                        <text x="220" y="334" class="node-status">
                            ✓ Processed
                        </text>
                    </g>

                    <!-- Inventory Service -->
                    <g class="node inventory-node" id="inventory-node">
                        <rect x="480" y="285" width="200" height="70" rx="10" />
                        <text x="580" y="313" class="node-title">
                            Inventory Service
                        </text>
                        <text
                                x="580"
                                y="334"
                                class="node-status"
                                id="inventory-status"
                        >
                            ✓ Processed
                        </text>
                    </g>
                </svg>
            </div>

            <div class="diagnostics" aria-live="polite">
                <div class="diagnostics-indicator" id="diagnostics-indicator"></div>

                <div>
                    <strong id="diagnostics-title">
                        All events processed successfully
                    </strong>

                    <p id="diagnostics-description">
                        Both consumers completed processing without errors.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(
        '.scenario'
    );

    const inventoryNode = document.getElementById('inventory-node');
    const inventoryStatus = document.getElementById('inventory-status');
    const diagnosticsIndicator = document.getElementById(
        'diagnostics-indicator'
    );
    const diagnosticsTitle = document.getElementById('diagnostics-title');
    const diagnosticsDescription = document.getElementById(
        'diagnostics-description'
    );

    buttons.forEach((button) => {
        button.addEventListener('click', () => {
            const failed = button.dataset.scenario === 'failed';

            buttons.forEach((item) => {
                const active = item === button;

                item.classList.toggle('active', active);
                item.setAttribute('aria-pressed', String(active));
            });

            inventoryNode?.classList.toggle('failed', failed);
            diagnosticsIndicator?.classList.toggle('failed', failed);

            if (inventoryStatus) {
                inventoryStatus.textContent = failed
                    ? '✕ Processing failed'
                    : '✓ Processed';
            }

            if (diagnosticsTitle) {
                diagnosticsTitle.textContent = failed
                    ? 'Event processing failed'
                    : 'All events processed successfully';
            }

            if (diagnosticsDescription) {
                diagnosticsDescription.textContent = failed
                    ? 'Inventory Service failed while processing OrderCreated.'
                    : 'Both consumers completed processing without errors.';
            }
        });
    });
</script>

<style>
