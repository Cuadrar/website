        margin: 18px 0;
        font-size: clamp(32px, 4vw, 48px);
        letter-spacing: -1.5px;
    }

    .section-heading p {
        max-width: 560px;
        margin: auto;
        color: var(--muted);
        line-height: 1.7;
    }

    .demo {
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #111114;
        overflow: hidden;
    }

    .demo-toolbar {
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid var(--border);
    }

    .demo-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 600;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 12px var(--accent);
    }

    .scenario-switch {
        display: flex;
        padding: 4px;
        gap: 4px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #09090b;
    }

    .scenario {
        border: none;
        border-radius: 6px;
        padding: 9px 14px;
        color: var(--muted);
        background: transparent;
        cursor: pointer;
        font-size: 12px;
        transition: 0.2s;
    }

    .scenario.active {
        background: #27272a;
        color: var(--text);
    }

    .scenario:hover {
        color: var(--text);
    }

    .graph-container {
        padding: 30px;
        overflow: hidden;
    }

    .graph {
        width: 100%;
        height: auto;
        display: block;
        max-height: 440px;
    }

    .connections path {
        fill: none;
        stroke: #52525b;
