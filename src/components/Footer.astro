---
const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="container">
        <div class="footer-main">
            <div class="brand">
                <a href="/" class="logo">
                    <span class="logo-icon">◈</span>
                    <span>cuadrar</span>
                </a>

                <p>
                    Make sense of your event-driven systems.
                </p>
            </div>

            <div class="footer-links">
                <div class="link-group">
                    <h4>Product</h4>
                    <a href="#features">Features</a>
                    <a href="#architecture">How it works</a>
                </div>

                <div class="link-group">
                    <h4>Community</h4>
                    <a
                            href="https://github.com/cuadrar"
                            target="_blank"
                            rel="noopener noreferrer"
                    >
                        GitHub ↗
                    </a>
                    <a
                            href="https://github.com/orgs/cuadrar/repositories"
                            target="_blank"
                            rel="noopener noreferrer"
                    >
                        Repositories ↗
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <span>© {year} Cuadrar</span>

            <span>Built for event-driven systems.</span>
        </div>
    </div>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--border);
        padding: 64px 0 24px;
        background: #0c0c0f;
    }

    .footer-main {
        display: flex;
        justify-content: space-between;
        gap: 48px;
        padding-bottom: 64px;
    }

    .logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.7px;
    }

    .logo-icon {
        color: var(--accent);
        font-size: 28px;
    }

    .brand p {
        margin-top: 16px;
        color: var(--muted);
        font-size: 14px;
    }

    .footer-links {
        display: flex;
        gap: 90px;
    }

    .link-group {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    h4 {
        margin: 0 0 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .link-group a {
        color: var(--muted);
        font-size: 13px;
        transition: color 0.2s ease;
    }

    .link-group a:hover {
        color: var(--text);
    }

    .footer-bottom {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
        color: #71717a;
        font-size: 12px;
    }

    @media (max-width: 640px) {
        .footer-main {
            flex-direction: column;
        }

        .footer-links {
            gap: 64px;
        }

        .footer-bottom {
            flex-direction: column;
        }
    }
</style>
